{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/.netlify/functions/articles",
      "destination": "/api/articles"
    },
    {
      "source": "/.netlify/functions/article",
      "destination": "/api/article"
    },
    {
      "source": "/article",
      "destination": "/article/index.html"
    },
    {
      "source": "/article/",
      "destination": "/article/index.html"
    },
    {
      "source": "/article/:slug",
      "destination": "/article/detail.html"
    }
  ]
}
